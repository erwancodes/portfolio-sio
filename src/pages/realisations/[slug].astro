---
import Layout from '../../layouts/Layout.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import {
  realisations,
  competenceByCode,
  sousCompetenceByCode,
} from '../../data/realisations';
import { frenchText } from '../../text';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return realisations.map((realisation) => ({
    params: { slug: realisation.slug },
    props: { realisation },
  }));
};

const { realisation } = Astro.props;

const competencesMobilisees = Array.from(
  new Set(realisation.sousCompetences.map((code) => code.split('.')[0]))
)
  .map((code) => competenceByCode(code))
  .filter(Boolean);

const blocLabels: Record<string, string> = {
  B1: 'Captures et documents',
  B2: 'Détails techniques',
  B3: 'Sécurité et bonnes pratiques',
};

const hasDetails = Boolean(realisation.contexte && realisation.environnementTechno?.length && realisation.preuves?.length);
---

<Layout title={`${frenchText(realisation.nom)} - Réalisations professionnelles`}>
  <article>
    <a
      href="/realisations"
      class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M15 19l-7-7 7-7" />
      </svg>
      Retour aux réalisations
    </a>

    <!-- En-tete -->
    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
          {realisation.type}
        </span>
        {realisation.periode && (
          <span class="font-mono text-xs text-muted-foreground">{realisation.periode}</span>
        )}
      </div>
      <h1 class="mt-3 text-2xl font-bold tracking-tight sm:text-3xl">{frenchText(realisation.nom)}</h1>
      {realisation.resume && (
        <p class="mt-3 leading-relaxed text-muted-foreground">{frenchText(realisation.resume)}</p>
      )}
    </header>

    {hasDetails ? null : (
      <section class="mt-8 rounded-lg border border-border bg-muted/30 p-4">
        <div class="flex items-center gap-2">
          <span class="rounded border border-border bg-card px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-muted-foreground">
            Synthèse
          </span>
          <p class="text-sm font-medium">Réalisation référencée dans le tableau de synthèse</p>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          Les documents de travail ne sont pas publiés sur cette page.
        </p>
      </section>
    )}

    <!-- Competences mobilisees -->
    <section class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
        Compétences mobilisées — Bloc 1
      </h2>
      <p class="mt-2 text-sm text-muted-foreground">Support et mise à disposition de services informatiques</p>
      <div class="mt-4 space-y-3">
        {competencesMobilisees.map((comp) => {
          const subsActives = realisation.sousCompetences
            .filter((code) => code.startsWith(`${comp.code}.`))
            .map((code) => sousCompetenceByCode(code))
            .filter(Boolean);
          return (
            <div class="rounded-lg border border-border p-4">
              <div class="flex items-start gap-3">
                <span class="inline-flex flex-shrink-0 items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
                  {comp.code.replace(/^B/, 'C')}
                </span>
                <div class="min-w-0">
                  <h3 class="font-medium leading-snug">{frenchText(comp.title)}</h3>
                  <ul class="mt-2 space-y-1">
                    {subsActives.map((sub) => (
                      <li class="flex items-start gap-2 text-sm text-muted-foreground">
                        <span class="font-mono text-[10px] text-foreground">{sub.code.replace(/^B/, 'C')}</span>
                        <span>{frenchText(sub.label)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    {realisation.contexte && (
      <section class="mt-10">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Contexte</h2>
        <div class="mt-3 space-y-3 leading-relaxed text-foreground/90">
          {realisation.contexte.split('\n\n').map((p) => <p>{frenchText(p)}</p>)}
        </div>
      </section>
    )}

    {realisation.environnementTechno && realisation.environnementTechno.length > 0 && (
      <section class="mt-10">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
          Environnement technologique
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {realisation.environnementTechno.map((tech) => (
            <span class="inline-flex items-center rounded-md border border-border bg-card px-2.5 py-0.5 font-mono text-xs text-card-foreground">
              {frenchText(tech)}
            </span>
          ))}
        </div>
      </section>
    )}

    {realisation.preuves && realisation.preuves.length > 0 && (
      <section class="mt-10">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Preuves</h2>
        <div class="mt-4 space-y-6">
          {realisation.preuves.map((groupe) => (
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-medium">{blocLabels[groupe.bloc] ?? groupe.bloc}</h3>
                {groupe.obligatoire && (
                  <span class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                    obligatoire
                  </span>
                )}
              </div>
              <div class="mt-3 space-y-3">
                {groupe.preuves.map((p) => {
                  if (p.type === 'image') {
                    const imageAlt = p.caption ? frenchText(p.caption) : 'Preuve de la réalisation';
                    return (
                      <figure class="overflow-hidden rounded-lg border border-border bg-card">
                        <button
                          type="button"
                          class="group relative block w-full cursor-zoom-in text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:ring-offset-background"
                          data-image-lightbox-trigger
                          data-caption={p.caption ? frenchText(p.caption) : ''}
                          aria-label={`Afficher en plein écran : ${imageAlt}`}
                        >
                          <img
                            src={p.src}
                            alt={imageAlt}
                            loading="lazy"
                            class="h-auto w-full transition duration-200 group-hover:brightness-90 group-focus-visible:brightness-90 motion-reduce:transition-none"
                          />
                          <span class="pointer-events-none absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-zinc-950/75 px-2.5 py-1 text-xs font-medium text-white opacity-0 shadow-sm transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none">
                            <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <circle cx="11" cy="11" r="7" />
                              <path d="m20 20-3.5-3.5M11 8v6M8 11h6" stroke-linecap="round" />
                            </svg>
                            Agrandir
                          </span>
                        </button>
                        {p.caption && (
                          <figcaption class="border-t border-border px-4 py-2 font-mono text-xs text-muted-foreground">
                            {frenchText(p.caption)}
                          </figcaption>
                        )}
                      </figure>
                    );
                  }
                  if (p.type === 'pdf') {
                    return (
                      <div class="space-y-1.5">
                        <a
                          href={p.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm transition-colors hover:bg-accent"
                        >
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                            <path d="M14 2v6h6" />
                          </svg>
                          {frenchText(p.label)}
                        </a>
                        {p.caption && <p class="font-mono text-xs text-muted-foreground">{frenchText(p.caption)}</p>}
                      </div>
                    );
                  }
                  if (p.type === 'lien') {
                    return (
                      <div class="space-y-1.5">
                        <a
                          href={p.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm transition-colors hover:bg-accent"
                        >
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                          {frenchText(p.label)}
                        </a>
                        {p.caption && <p class="font-mono text-xs text-muted-foreground">{frenchText(p.caption)}</p>}
                      </div>
                    );
                  }
                  return (
                    <figure class="overflow-hidden rounded-lg border border-border bg-card">
                      <pre class="overflow-x-auto px-4 py-3 font-mono text-xs"><code>{frenchText(p.content)}</code></pre>
                        {p.caption && (
                          <figcaption class="border-t border-border px-4 py-2 font-mono text-xs text-muted-foreground">
                            {frenchText(p.caption)}
                          </figcaption>
                      )}
                    </figure>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
  <ImageLightbox />
</Layout>
