---
import Layout from '../../layouts/Layout.astro';
import {
  articles,
  bornages,
  outils,
  misesEnOeuvre,
  themeVeille,
  formatDate,
} from '../../data/veille';
import { frenchText } from '../../text';

const articlesParBornage = bornages.map((b) => ({
  bornage: b,
  articles: articles
    .filter((a) => a.bornageId === b.id)
    .sort((a, c) => new Date(c.date).getTime() - new Date(a.date).getTime()),
}));

const outilsPermanents = outils.filter((o) => o.type === 'permanent');
const outilsMensuels = outils.filter((o) => o.type === 'mensuel');
const articlesVisiblesParBornage = 2;
---

<Layout title="Veille technologique - Erwan Sagnardon">
  <!-- Hero + theme -->
  <section class="pb-12">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Veille technologique</h1>
    <p class="mt-2 font-mono text-sm text-muted-foreground">Thème : {frenchText(themeVeille)}</p>
    <p class="mt-6 max-w-2xl leading-relaxed text-muted-foreground">
      Suivi des avancées en robotique humanoïde et industrielle, ainsi que des modèles d&apos;IA
      capables de simuler le monde physique.
    </p>
    <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-muted-foreground">
      <span>{articles.length} actualités</span>
      <span>{outils.length} outils suivis</span>
      <span>{bornages.length} bornages</span>
    </div>
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Accès rapide dans la veille">
      <a href="#bornage" class="rounded-md border border-border bg-card px-2.5 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">Bornage</a>
      <a href="#outils" class="rounded-md border border-border bg-card px-2.5 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">Outils</a>
      <a href="#actualites" class="rounded-md border border-border bg-card px-2.5 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">Actualités</a>
      <a href="#mise-en-oeuvre" class="rounded-md border border-border bg-card px-2.5 py-1.5 font-mono text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">Mise en œuvre</a>
    </nav>
  </section>

  <!-- Bornage -->
  <section id="bornage" class="scroll-mt-6 border-t border-border py-12">
    <h2 class="text-lg font-semibold tracking-tight">Bornage</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
      Robotique humanoïde open source et modèles de monde pour l’IA robotique.
    </p>
    <div class="mt-6 grid gap-3 sm:grid-cols-2">
      {bornages.map((b) => (
        <article class="rounded-lg border border-border bg-card p-4">
          <div class="flex items-start gap-2">
            <span class="inline-flex flex-shrink-0 items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
              {b.id}
            </span>
            <h3 class="font-medium leading-snug">{frenchText(b.titre.replace(/^Bornage \d+ — /, ''))}</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{frenchText(b.description)}</p>
          <div class="mt-3">
            <p class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground">Mots-clés</p>
            <div class="mt-1.5 flex flex-wrap gap-1.5">
              {b.motsCles.map((mc) => (
                <span class="rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                  {frenchText(mc)}
                </span>
              ))}
            </div>
          </div>
          {b.exclusions && b.exclusions.length > 0 && (
            <div class="mt-3">
              <p class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground">Exclusions</p>
              <p class="mt-1 text-xs text-muted-foreground">{frenchText(b.exclusions.join(' · '))}</p>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Outils de veille -->
  <section id="outils" class="scroll-mt-6 border-t border-border py-12">
    <h2 class="text-lg font-semibold tracking-tight">Outils de veille</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
      Des outils permanents, complétés par un nouvel outil testé chaque mois à partir de mars 2026.
    </p>

    <div class="mt-6 space-y-6">
      <div>
        <h3 class="font-mono text-xs uppercase tracking-wide text-muted-foreground">Outils permanents</h3>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {outilsPermanents.map((o) => (
            <a
              href={o.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent"
            >
              <div class="flex items-center justify-between">
                <h4 class="font-medium group-hover:text-foreground">{o.nom}</h4>
                <span class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                  {frenchText(o.categorie)}
                </span>
              </div>
            <p class="mt-2 text-sm text-muted-foreground">{frenchText(o.description)}</p>
            {o.retourExperience && (
                <p class="mt-2 text-xs italic text-muted-foreground">{frenchText(o.retourExperience)}</p>
              )}
            </a>
          ))}
        </div>
      </div>

      {outilsMensuels.length > 0 && (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
            Outils testés chaque mois
          </h3>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {outilsMensuels.map((o) => (
              <a
                href={o.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent"
              >
                <div class="flex items-center justify-between">
                  <h4 class="font-medium group-hover:text-foreground">{o.nom}</h4>
                  {o.moisTeste && (
                    <span class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                      {o.moisTeste}
                    </span>
                  )}
                </div>
                <p class="mt-1 font-mono text-[10px] text-muted-foreground">{frenchText(o.categorie)}</p>
                <p class="mt-2 text-sm text-muted-foreground">{frenchText(o.description)}</p>
                {o.retourExperience && (
                  <p class="mt-2 text-xs italic text-muted-foreground">{frenchText(o.retourExperience)}</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- News par bornage -->
  <section id="actualites" class="scroll-mt-6 border-t border-border py-12">
    <h2 class="text-lg font-semibold tracking-tight">Actualités</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
      Dernières avancées, projets open source et travaux de recherche.
    </p>

    <div class="mt-6 space-y-8">
      {articlesParBornage.map(({ bornage, articles: list }) => (
        <div>
          <header class="flex items-baseline gap-2">
            <span class="inline-flex items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
              {bornage.id}
            </span>
            <h3 class="text-sm font-semibold">{frenchText(bornage.titre.replace(/^Bornage \d+ — /, ''))}</h3>
          </header>
          {list.length === 0 ? (
            <p class="mt-3 rounded-lg border border-dashed border-border p-4 text-sm text-muted-foreground">
              Aucune actualité pour le moment sur ce bornage.
            </p>
          ) : (
            <>
            <div id={`archive-${bornage.id}`} class="mt-3 space-y-3">
              {list.map((article, index) => (
                <a
                  href={`/veille/${article.slug}`}
                  data-archive-item={index >= articlesVisiblesParBornage ? bornage.id : undefined}
                  class:list={[
                    'group block rounded-lg border border-border bg-card p-5 transition-colors hover:bg-accent',
                    index >= articlesVisiblesParBornage && 'hidden',
                  ]}
                >
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center rounded border border-border px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">
                          {frenchText(article.tag)}
                        </span>
                        <span class="font-mono text-xs text-muted-foreground">
                          {formatDate(article.date)}
                        </span>
                      </div>
                      <h4 class="mt-2 font-medium leading-snug group-hover:text-foreground">
                          {frenchText(article.title)}
                      </h4>
                      <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                        {frenchText(article.summary)}
                      </p>
                      <p class="mt-2 font-mono text-[10px] text-muted-foreground">
                        Source : {frenchText(article.sourceLabel)}
                      </p>
                    </div>
                    <svg
                      class="mt-1 h-4 w-4 flex-shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              ))}
            </div>
            {list.length > articlesVisiblesParBornage && (
              <button
                type="button"
                data-archive-toggle={bornage.id}
                data-archive-count={list.length - articlesVisiblesParBornage}
                aria-expanded="false"
                aria-controls={`archive-${bornage.id}`}
                class="mt-3 rounded-md border border-border px-3 py-2 font-mono text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
              >
                Voir l&apos;archive ({list.length - articlesVisiblesParBornage})
              </button>
            )}
            </>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- Mise en oeuvre -->
  <section id="mise-en-oeuvre" class="scroll-mt-6 border-t border-border py-12">
    <h2 class="text-lg font-semibold tracking-tight">Applications concrètes</h2>
    <p class="mt-2 max-w-2xl text-sm text-muted-foreground">
      Mises en œuvre concrètes : décisions techniques, projets ou interventions
      directement issus de cette veille.
    </p>
    {misesEnOeuvre.length === 0 ? (
      <div class="mt-6 rounded-lg border border-dashed border-border p-4 text-sm text-muted-foreground">
        Aucune mise en œuvre publiée pour le moment.
      </div>
    ) : (
      <div class="mt-6 space-y-3">
        {misesEnOeuvre.map((m) => (
          <article class="rounded-lg border border-border bg-card p-4">
            <h3 class="font-medium">{frenchText(m.titre)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{frenchText(m.description)}</p>
            {m.lien && (
              <a
                href={m.lien.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex items-center gap-1.5 font-mono text-xs text-foreground transition-colors hover:underline"
              >
                {frenchText(m.lien.label)}
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M14 3h7v7M10 14L21 3M21 14v7H3V3h7" />
                </svg>
              </a>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-archive-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const bornageId = button.dataset.archiveToggle;
      if (!bornageId) return;

      const expanded = button.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll<HTMLElement>(`[data-archive-item="${bornageId}"]`).forEach((article) => {
        article.classList.toggle('hidden', expanded);
      });
      button.setAttribute('aria-expanded', String(!expanded));
      const count = button.dataset.archiveCount ?? '0';
      button.textContent = expanded ? `Voir l'archive (${count})` : `Masquer l'archive (${count})`;
    });
  });
</script>
