---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rectorat - BTS SIO SLAM - Erwan Sagnardon">
  <section class="pb-12">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Rectorat</h1>
    <p class="mt-2 font-mono text-sm text-muted-foreground">
      BTS SIO option SLAM &middot; Session 2026
    </p>
    <p class="mt-6 max-w-2xl leading-relaxed text-muted-foreground">
      Tableau de synthèse des réalisations professionnelles,
      attestations de stage et éléments spécifiques aux épreuves E5 et E6.
    </p>
  </section>

  <section class="grid gap-4 sm:grid-cols-2">
    <button
      type="button"
      data-modal-open="modal-e5"
      class="group flex flex-col items-start rounded-lg border border-border bg-card p-6 text-left transition-colors hover:bg-accent"
    >
      <span class="inline-flex items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
        E5
      </span>
      <h2 class="mt-3 text-xl font-semibold tracking-tight">Sous-option E5</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Tableau de synthèse et attestations de stage.
      </p>
      <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors group-hover:text-foreground">
        Ouvrir
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </button>

    <button
      type="button"
      data-modal-open="modal-e6"
      class="group flex flex-col items-start rounded-lg border border-border bg-card p-6 text-left transition-colors hover:bg-accent"
    >
      <span class="inline-flex items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
        E6
      </span>
      <h2 class="mt-3 text-xl font-semibold tracking-tight">Sous-option E6</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        Documents non disponibles.
      </p>
      <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground transition-colors group-hover:text-foreground">
        Ouvrir
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </button>
  </section>

  <!-- Modal E5 -->
  <dialog
    id="modal-e5"
    class="m-auto w-full max-w-2xl rounded-lg border border-border bg-background p-0 text-foreground shadow-xl backdrop:bg-black/60"
  >
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div class="flex items-baseline gap-3">
        <span class="inline-flex items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
          E5
        </span>
        <h3 class="text-lg font-semibold">Sous-option E5</h3>
      </div>
      <button
        type="button"
        data-modal-close
        aria-label="Fermer"
        class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="space-y-6 px-6 py-5">
      <div class="space-y-3">
        <h4 class="text-base font-medium">Tableau de synthèse</h4>
        <p class="text-sm text-muted-foreground">
          Recensement des réalisations professionnelles avec les compétences mobilisées.
        </p>
        <a
          href="/files/tableau-synthese.xlsx"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-border bg-muted/50 px-4 py-2.5 text-sm font-medium transition-colors hover:bg-accent"
        >
          <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
          </svg>
          <span>Télécharger le tableau de synthèse (.xlsx)</span>
        </a>
      </div>

      <div class="space-y-3">
        <h4 class="text-base font-medium">Attestations de stage</h4>
        <p class="text-sm text-muted-foreground">
          Justificatifs des périodes en milieu professionnel.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <figure class="space-y-2">
            <div class="relative aspect-[1/1.414] overflow-hidden rounded-lg border border-dashed border-border bg-muted/30">
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-6 text-center">
                <svg class="h-10 w-10 text-muted-foreground/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">
                  Attestation — 1re année
                </p>
                <span class="mt-2 inline-flex items-center rounded border border-border bg-background px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                  Document non disponible
                </span>
              </div>
            </div>
            <figcaption class="text-xs text-muted-foreground">
              Stage de 1re année
            </figcaption>
          </figure>

          <figure class="space-y-2">
            <div class="relative aspect-[1/1.414] overflow-hidden rounded-lg border border-dashed border-border bg-muted/30">
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-6 text-center">
                <svg class="h-10 w-10 text-muted-foreground/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">
                  Attestation — 2e année
                </p>
                <span class="mt-2 inline-flex items-center rounded border border-border bg-background px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-muted-foreground">
                  Document non disponible
                </span>
              </div>
            </div>
            <figcaption class="text-xs text-muted-foreground">
              Stage de 2e année
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Modal E6 -->
  <dialog
    id="modal-e6"
    class="m-auto w-full max-w-2xl rounded-lg border border-border bg-background p-0 text-foreground shadow-xl backdrop:bg-black/60"
  >
    <div class="flex items-center justify-between border-b border-border px-6 py-4">
      <div class="flex items-baseline gap-3">
        <span class="inline-flex items-center rounded border border-border bg-muted px-2 py-0.5 font-mono text-xs text-muted-foreground">
          E6
        </span>
        <h3 class="text-lg font-semibold">Sous-option E6</h3>
      </div>
      <button
        type="button"
        data-modal-close
        aria-label="Fermer"
        class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="px-6 py-5">
      <div class="rounded-lg border border-dashed border-border p-6 text-sm text-muted-foreground">
        Documents non disponibles.
      </div>
    </div>
  </dialog>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-modal-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.modalOpen;
      if (!id) return;
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-modal-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.closest('dialog')?.close();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
