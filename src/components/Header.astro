---
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/stage', label: 'Stage' },
  { href: '/realisations', label: 'Réalisations professionnelles' },
  { href: '/veille', label: 'Veille' },
  { href: '/rectorat', label: 'Rectorat' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="flex items-center justify-between border-b border-border py-6">
  <a href="/" class="font-mono text-sm font-semibold tracking-tight text-foreground">
    E.S
  </a>

  <nav class="hidden items-center gap-1 sm:flex">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'rounded-md px-3 py-1.5 text-sm transition-colors',
          pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href))
            ? 'bg-accent text-accent-foreground font-medium'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent',
        ]}
      >
        {link.label}
      </a>
    ))}
    <button
      id="theme-toggle"
      data-theme-toggle
      class="ml-2 rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      aria-label="Changer de thème"
      title="Changer de thème"
    >
      <svg id="sun-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
      </svg>
      <svg id="moon-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg id="gray-icon" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="8" />
        <path d="M4 12h16M12 4v16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div class="flex items-center gap-2 sm:hidden">
    <button
      id="theme-toggle-mobile"
      data-theme-toggle
      class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      aria-label="Changer de thème"
      title="Changer de thème"
    >
      <svg id="sun-icon-mobile" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
      </svg>
      <svg id="moon-icon-mobile" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg id="gray-icon-mobile" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="8" />
        <path d="M4 12h16M12 4v16" />
      </svg>
    </button>
    <button
      id="mobile-menu-btn"
      class="rounded-md p-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      aria-label="Menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile nav -->
<nav id="mobile-nav" class="hidden border-b border-border pb-4 sm:hidden">
  {links.map((link) => (
    <a
      href={link.href}
      class:list={[
        'block rounded-md px-3 py-2 text-sm transition-colors',
        pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href))
          ? 'bg-accent text-accent-foreground font-medium'
          : 'text-muted-foreground hover:text-foreground hover:bg-accent',
      ]}
    >
      {link.label}
    </a>
  ))}
</nav>

<script>
  function updateIcons() {
    const theme = document.documentElement.dataset.theme ?? 'light';
    const labels = { light: 'clair', dark: 'sombre', gray: 'gris foncé' };
    document.querySelectorAll('#sun-icon, #sun-icon-mobile').forEach((el) => el.classList.toggle('hidden', theme !== 'light'));
    document.querySelectorAll('#moon-icon, #moon-icon-mobile').forEach((el) => el.classList.toggle('hidden', theme !== 'dark'));
    document.querySelectorAll('#gray-icon, #gray-icon-mobile').forEach((el) => el.classList.toggle('hidden', theme !== 'gray'));
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', `Thème actuel : ${labels[theme as keyof typeof labels]}. Cliquer pour changer`);
      button.setAttribute('title', `Thème actuel : ${labels[theme as keyof typeof labels]}`);
    });
  }

  function toggleTheme() {
    const themes = ['light', 'dark', 'gray'];
    const current = document.documentElement.dataset.theme ?? 'light';
    const next = themes[(themes.indexOf(current) + 1) % themes.length];
    document.documentElement.dataset.theme = next;
    document.documentElement.classList.toggle('dark', next === 'dark');
    document.documentElement.classList.toggle('gray', next === 'gray');
    localStorage.setItem('theme', next);
    updateIcons();
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    const mobileNav = document.getElementById('mobile-nav');
    const isOpen = mobileNav?.classList.toggle('hidden') === false;
    document.getElementById('mobile-menu-btn')?.setAttribute('aria-expanded', String(isOpen));
  });

  updateIcons();
</script>
