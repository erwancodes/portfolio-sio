<dialog class="image-lightbox" data-image-lightbox aria-label="Agrandissement de l’image">
  <button class="image-lightbox__close" type="button" data-image-lightbox-close aria-label="Fermer l’image agrandie">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" />
    </svg>
  </button>

  <figure class="image-lightbox__figure">
    <img data-image-lightbox-image src="" alt="" />
    <figcaption class="image-lightbox__caption" data-image-lightbox-caption></figcaption>
  </figure>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-image-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-image-lightbox-image]');
  const caption = dialog?.querySelector<HTMLElement>('[data-image-lightbox-caption]');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-image-lightbox-close]');
  let returnFocus: HTMLElement | null = null;

  const closeLightbox = () => {
    if (dialog?.open) dialog.close();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-image-lightbox-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog || !image || !caption) return;

      const preview = trigger.querySelector<HTMLImageElement>('img');
      if (!preview) return;

      returnFocus = trigger;
      image.src = preview.currentSrc || preview.src;
      image.alt = preview.alt;
      caption.textContent = trigger.dataset.caption ?? '';
      caption.hidden = !caption.textContent;
      document.documentElement.classList.add('image-lightbox-open');
      dialog.showModal();
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener('click', closeLightbox);

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeLightbox();
  });

  dialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('image-lightbox-open');
    image?.removeAttribute('src');
    returnFocus?.focus();
    returnFocus = null;
  });
</script>

<style>
  :global(html.image-lightbox-open) {
    overflow: hidden;
  }

  .image-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    border: 0;
    background: rgb(9 9 11 / 0.96);
    color: #fafafa;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .image-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .image-lightbox::backdrop {
    background: rgb(9 9 11 / 0.96);
  }

  .image-lightbox__figure {
    display: grid;
    max-width: 100%;
    max-height: 100%;
    place-items: center;
    gap: 0.75rem;
  }

  .image-lightbox__figure img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 6rem);
    border-radius: 0.5rem;
    object-fit: contain;
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.45);
  }

  .image-lightbox__caption {
    max-width: 52rem;
    text-align: center;
    font-size: 0.8125rem;
    color: #d4d4d8;
  }

  .image-lightbox__close {
    position: fixed;
    z-index: 1;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 9999px;
    background: rgb(24 24 27 / 0.8);
    color: #fafafa;
    transition: background-color 150ms ease, transform 150ms ease;
  }

  .image-lightbox__close:hover {
    background: #3f3f46;
  }

  .image-lightbox__close:active {
    transform: scale(0.96);
  }

  .image-lightbox__close:focus-visible {
    outline: 2px solid #fafafa;
    outline-offset: 3px;
  }

  .image-lightbox__close svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .image-lightbox__close {
      transition: none;
    }
  }
</style>
