---
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-8">
  <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
    <p class="text-sm text-muted-foreground">
      &copy; {year} Erwan Sagnardon
    </p>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/ErwanCodes"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        GitHub
      </a>
      <a
        href="mailto:erwan.sagnardon@campus-la-chataigneraie.org"
        class="text-sm text-muted-foreground transition-colors hover:text-foreground"
      >
        Email
      </a>
    </div>
  </div>
  <p class="mt-4 text-center text-sm text-muted-foreground">
    Conçu avec ❤️ par Erwan Sagnardon
  </p>
    <div data-back-to-top-container class="mt-6 hidden justify-center">
      <button
        type="button"
        data-back-to-top
        aria-label="Retour en haut de la page"
        title="Retour en haut"
        class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground active:scale-95"
      >
        <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m-6 6 6-6 6 6" />
        </svg>
        <span>Retour en haut</span>
      </button>
    </div>
</footer>

<script>
  const backToTopContainer = document.querySelector<HTMLElement>('[data-back-to-top-container]');
  const main = document.querySelector('main');

  const updateBackToTopVisibility = () => {
    // Base the threshold on content, so showing the button cannot affect it.
    const isLongPage = (main?.scrollHeight ?? 0) > window.innerHeight * 1.5;
    backToTopContainer?.classList.toggle('hidden', !isLongPage);
    backToTopContainer?.classList.toggle('flex', isLongPage);
  };

  updateBackToTopVisibility();
  window.addEventListener('resize', updateBackToTopVisibility);
  if (main) new ResizeObserver(updateBackToTopVisibility).observe(main);

  document.querySelector<HTMLButtonElement>('[data-back-to-top]')?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    });
    document.querySelector<HTMLAnchorElement>('header a')?.focus({ preventScroll: true });
  });
</script>
